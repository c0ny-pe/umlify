@baseUrl = http://localhost:3001/api

### Register a new user
### The JWT is set as an HttpOnly cookie (not returned in the body); the REST
### Client extension keeps a cookie jar per file, so it's resent automatically
### on the requests below.
POST {{baseUrl}}/users/register
Content-Type: application/json

{
    "username": "test-user",
    "password": "password"
}

###
### Get a public user by id (no auth required)
GET {{baseUrl}}/users/1

###
### Authentication flow
# @name login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
    "username": "test-user",
    "password": "password"
}

###
### The login/register response also carries the CSRF token in this header;
### capture it and send it back as X-CSRF-Token on every protected request.
@csrfToken = {{login.response.headers.X-CSRF-Token}}

### Restore session (used by the frontend on page load)
GET {{baseUrl}}/users/me
X-CSRF-Token: {{csrfToken}}

###
### Log out (clears the cookie)
POST {{baseUrl}}/users/logout

###
### Create a diagram (must be authenticated)
POST {{baseUrl}}/diagrams
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
    "name": "Diagrama de Clases Memoria",
    "content": {
        "nodes": [
            {
                "id": "1",
                "name": "Usuario",
                "classType": "concreteClass",
                "methods": [
                    {
                        "name": "getUsername",
                        "domType": [],
                        "codType": "String",
                        "visibility": "public",
                        "abstract": false
                    }
                ],
                "fields": [
                    {
                        "name": "username",
                        "type": "String",
                        "visibility": "private"
                    }
                ],
                "x": 100,
                "y": 150
            },
            {
                "id": "2",
                "name": "Diagrama",
                "classType": "concreteClass",
                "methods": [],
                "fields": [],
                "x": 400,
                "y": 150
            }
        ],
        "edges": [
            {
                "source": "1",
                "target": "2",
                "type": "association",
                "sourceHandle": "right",
                "targetHandle": "left"
            }
        ]
    }
}

###
### List diagrams for authenticated user
GET {{baseUrl}}/diagrams
X-CSRF-Token: {{csrfToken}}

###
### Get specific diagram by id (must be owner)
GET {{baseUrl}}/diagrams/{diagram_id}
X-CSRF-Token: {{csrfToken}}

###
### Update diagram (must be owner)
PUT {{baseUrl}}/diagrams/{diagram_id}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
    "name": "Diagrama Actualizado",
    "content": {
        "nodes": [],
        "edges": []
    }
}

###
### Delete diagram (must be owner)
DELETE {{baseUrl}}/diagrams/{diagram_id}
X-CSRF-Token: {{csrfToken}}

