# Copy to backend/.env on the server and fill in real values.
# Used by the backend (pg + node-pg-migrate) and the `update` deploy script.

# Single connection string for the dedicated umlify Postgres role/db on localhost.
DATABASE_URL=postgresql://umlify:CHANGE_ME@localhost:5432/umlify

# Secret for signing JWT access tokens. Use a long random value.
JWT_SECRET=CHANGE_ME

# Origin allowed by CORS. Same-origin in production, so mostly a safety net.
FRONTEND_URL=https://cc3002.dcc.uchile.cl

# PORT and BASE_PATH are provided by ecosystem.config.js (8009, /umlify),
# but can be overridden here if needed.
